# cp .env.example .env 후 값을 채운다. .env는 git에 올라가지 않는다. (setup-a1.sh가 앞의 세 값은 자동으로 만든다)

# 사이트 주소: 도메인 또는 <A1 공인 IP의 점을 대시로>.sslip.io (예: 152-70-1-2.sslip.io)
SITE_ADDRESS=example.sslip.io

# DB 비밀번호: openssl rand -hex 24 (영문·숫자만 — 접속 URL에 그대로 들어감)
POSTGRES_PASSWORD=change-me
# 로그인 쿠키 서명 키: openssl rand -hex 32
COOKIE_SECRET=change-me-to-64-hex-chars

# 소셜 로그인 (docs/DEPLOY_A1.md 4단계). 콜백 주소:
#   Google: https://<SITE_ADDRESS>/api/auth/google/callback
#   GitHub: https://<SITE_ADDRESS>/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
