# 로컬 개발용 예시 (운영 설정은 deploy/.env.example)
DATABASE_URL=postgres://zoo:zoo-dev@127.0.0.1:5433/zoo
PORT=8787
# HTTPS가 아니면 0
COOKIE_SECURE=0
# 비우면 Origin 검사 안 함
ALLOWED_ORIGIN=http://localhost:5317

# 테스트 서버(5318 ↔ API 8788, DB zoo_e2e) 브라우저 확인용 계정 — 로컬 테스트 DB에만 존재
E2E_USERNAME=e2e_tester
E2E_PASSWORD=e2e-only-pass-7319
