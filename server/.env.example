# 로컬 개발용 예시 (운영 설정은 deploy/.env.example)
DATABASE_URL=postgres://zoo:zoo-dev@127.0.0.1:5433/zoo
PORT=8787
# 게임 개발 서버 주소 (OAuth 콜백이 이 주소의 /api/auth/<provider>/callback 으로 돌아옴 — Vite가 프록시)
PUBLIC_URL=http://localhost:5317
COOKIE_SECRET=local-dev-cookie-secret-change-me-0123456789
# 로컬 전용 가짜 로그인 버튼 (localhost에서만 켜짐)
DEV_LOGIN=1
# 실제 소셜 로그인을 로컬에서 시험하려면 각 콘솔에 http://localhost:5317/api/auth/<provider>/callback 을 등록
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
